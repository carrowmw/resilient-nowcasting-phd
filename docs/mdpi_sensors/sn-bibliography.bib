@article{tangHybridApproachIntegrate2015,
  title = {A Hybrid Approach to Integrate Fuzzy {{C-means}} Based Imputation Method with Genetic Algorithm for Missing Traffic Volume Data Estimation},
  author = {Tang, Jinjun and Zhang, Guohui and Wang, Yinhai and Wang, Hua and Liu, Fang},
