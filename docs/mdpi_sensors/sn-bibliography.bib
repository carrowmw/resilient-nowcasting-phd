@article{marinOcclusionHandlingRandom2014,
  title = {Occlusion {{Handling}} via {{Random Subspace Classifiers}} for {{Human Detection}}},
  author = {Mar{\'i}n, Javier and V{\'a}zquez, David and L{\'o}pez, Antonio M. and Amores, Jaume and Kuncheva, Ludmila I.},
  year = {2014},
  month = mar,
  journal = {IEEE Transactions on Cybernetics},
  volume = {44},
